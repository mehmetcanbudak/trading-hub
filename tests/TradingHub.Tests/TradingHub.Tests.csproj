<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../tools/TradingHub.I18n/provenance.json" Link="i18n-provenance.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TradingHub.Core\TradingHub.Core.csproj" />
    <ProjectReference Include="..\..\src\TradingHub.Strategies\TradingHub.Strategies.csproj" />
    <ProjectReference Include="..\..\src\TradingHub.Sdk\TradingHub.Sdk.csproj" />
    <ProjectReference Include="..\..\src\TradingHub.Charting\TradingHub.Charting.csproj" />
    <!-- lo propio de cada sistema (atajos, claves, Claude Code, bandeja): ver PlatformTests -->
    <ProjectReference Include="..\..\src\TradingHub.App\TradingHub.App.csproj" />
    <ProjectReference Include="..\TradingHub.LedgerCrashFixture\TradingHub.LedgerCrashFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TradingHub.QuantColdFixture\TradingHub.QuantColdFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TradingHub.AssistantCliFixture\TradingHub.AssistantCliFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TradingHub.IbSnapshotCrashFixture\TradingHub.IbSnapshotCrashFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyLedgerCrashFixture" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)/../TradingHub.LedgerCrashFixture/TradingHub.LedgerCrashFixture.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" RebaseOutputs="true">
      <Output TaskParameter="TargetOutputs" ItemName="LedgerCrashFixtureTarget" />
    </MSBuild>
    <PropertyGroup>
      <_LedgerCrashFixtureDirectory>@(LedgerCrashFixtureTarget->'%(RootDir)%(Directory)')</_LedgerCrashFixtureDirectory>
    </PropertyGroup>
    <ItemGroup>
      <LedgerCrashFixtureFiles Include="$(_LedgerCrashFixtureDirectory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(LedgerCrashFixtureFiles)" DestinationFiles="@(LedgerCrashFixtureFiles->'$(OutDir)LedgerCrashFixture/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="CopyQuantColdFixture" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)/../TradingHub.QuantColdFixture/TradingHub.QuantColdFixture.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" RebaseOutputs="true">
      <Output TaskParameter="TargetOutputs" ItemName="QuantColdFixtureTarget" />
    </MSBuild>
    <PropertyGroup>
      <_QuantColdFixtureDirectory>@(QuantColdFixtureTarget->'%(RootDir)%(Directory)')</_QuantColdFixtureDirectory>
    </PropertyGroup>
    <ItemGroup>
      <QuantColdFixtureFiles Include="$(_QuantColdFixtureDirectory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(QuantColdFixtureFiles)" DestinationFiles="@(QuantColdFixtureFiles->'$(OutDir)QuantColdFixture/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="CopyAssistantCliFixture" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)/../TradingHub.AssistantCliFixture/TradingHub.AssistantCliFixture.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" RebaseOutputs="true">
      <Output TaskParameter="TargetOutputs" ItemName="AssistantCliFixtureTarget" />
    </MSBuild>
    <PropertyGroup>
      <_AssistantCliFixtureDirectory>@(AssistantCliFixtureTarget->'%(RootDir)%(Directory)')</_AssistantCliFixtureDirectory>
    </PropertyGroup>
    <ItemGroup>
      <AssistantCliFixtureFiles Include="$(_AssistantCliFixtureDirectory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(AssistantCliFixtureFiles)" DestinationFiles="@(AssistantCliFixtureFiles->'$(OutDir)AssistantCliFixture/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="CopyIbSnapshotCrashFixture" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)/../TradingHub.IbSnapshotCrashFixture/TradingHub.IbSnapshotCrashFixture.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" RebaseOutputs="true">
      <Output TaskParameter="TargetOutputs" ItemName="IbSnapshotCrashFixtureTarget" />
    </MSBuild>
    <PropertyGroup>
      <_IbSnapshotCrashFixtureDirectory>@(IbSnapshotCrashFixtureTarget->'%(RootDir)%(Directory)')</_IbSnapshotCrashFixtureDirectory>
    </PropertyGroup>
    <ItemGroup>
      <IbSnapshotCrashFixtureFiles Include="$(_IbSnapshotCrashFixtureDirectory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(IbSnapshotCrashFixtureFiles)" DestinationFiles="@(IbSnapshotCrashFixtureFiles->'$(OutDir)IbSnapshotCrashFixture/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>


</Project>